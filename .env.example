# Copy to .env and fill in real values for your environment.
# .env is git-ignored; this file (.env.example) is the only one meant to be tracked.
# See docs/configuration.md for what each variable is used for.
# None of this is needed to run the synthetic demo (make demo) - it supplies its own
# throwaway values and never reads .env.

# GPS target database
GPS_SQL_USERNAME=changeme
GPS_SQL_PASSWORD=changeme
GPS_SQL_HOST=changeme
GPS_SQL_DB=changeme

# Legacy source databases (shared username, password and host; one DB name each)
LEGACY_SQL_USERNAME=changeme
LEGACY_SQL_PASSWORD=changeme
LEGACY_SQL_HOST=changeme
LEGACY_SQL_SP_NOTES=changeme
LEGACY_SQL_SP_TIME=changeme
LEGACY_SQL_SP_FULFILLMENT=changeme
LEGACY_SQL_SP_READINGS=changeme

# Azure AD (Microsoft Graph)
AZURE_TENANT_ID=changeme
AZURE_CLIENT_ID=changeme
AZURE_CLIENT_SECRET=changeme
AZURE_GROUP_ID=changeme
